# Copia este archivo a ".env" para uso local. En Azure se definen como "App settings".

# Si la confianza del modelo es menor, se sube un nivel la prioridad (nunca a rojo)
UMBRAL_CONFIANZA=0.60

# Si se define, la API exige la cabecera X-API-Key (excepto /salud)
API_KEY=

# Orígenes permitidos por CORS, separados por comas. Vacío = CORS desactivado
CORS_ORIGENES=http://localhost:3000

# Rutas opcionales (por defecto: data/dataset_triaje.csv y models/modelos_triaje.joblib)
# DATASET_PATH=data/dataset_triaje.csv
# MODELO_PATH=models/modelos_triaje.joblib

LOG_LEVEL=INFO
